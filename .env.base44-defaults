# Local development placeholders — real secrets in /run/base44/app.env override these.
# Clerk (external auth) — placeholders so the app boots; replace with real keys for full functionality.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_dev_placeholder
CLERK_SECRET_KEY=sk_test_dev_placeholder
SKIP_CLERK_CI_BUILD=1

# JWT / app secrets — generated placeholders
JWT_SECRET_KEY=dev_jwt_secret_placeholder
BLUE_SECRET_KEY=dev_blue_secret_placeholder
CREATION_SECRET_KEY=dev_creation_secret_placeholder

# Supabase (optional — storage defaults to local mode)
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
NEXT_PUBLIC_SUPABASE_KEY=placeholder
NEXT_PUBLIC_STORAGE_URL=https://placeholder.supabase.co/storage/v1/object/public/humansonly-media
SUPABASE_STORAGE_BUCKET=humansonly-media

# Upload config
UPLOAD_ALLOWED_MEDIA_HOSTS=localhost
UPLOAD_MAX_REQUEST_BYTES=54525952
UPLOAD_STORAGE_PROVIDER=local

# Admin config
SUPER_ADMIN_USERNAMES=admin
SUPER_ADMIN_CLERK_IDS=

# Human challenge / authenticity config (dry run by default)
HUMAN_ENFORCEMENT_MODE=adaptive
HUMAN_CHALLENGE_PROVIDER=turnstile
HUMAN_CHALLENGE_TTL_SECONDS=300
HUMAN_REVIEW_THRESHOLD=0.72
HUMAN_BLOCK_THRESHOLD=0.90
HUMAN_RULES_VERSION=2026-03-02.1
HUMAN_DRY_RUN=true
TURNSTILE_SECRET_KEY=dev_turnstile_placeholder
NEXT_PUBLIC_TURNSTILE_SITE_KEY=dev_turnstile_site_placeholder
